# ==============================================================================
# CloudQuery & PostgreSQL Environment Configuration
# ==============================================================================

# PostgreSQL database container settings
POSTGRES_DB=cloudquery
POSTGRES_USER=cq_admin
POSTGRES_PASSWORD=MySecretCQPassword123!

# Connection string used by CloudQuery PostgreSQL destination plugin
CQ_PG_CONNECTION_STRING=postgresql://cq_admin:MySecretCQPassword123!@127.0.0.1:5435/cloudquery?sslmode=disable

# Optional log level for CloudQuery sync CLI (info, warn, error, debug)
# Default is 'info'
CQ_LOG_LEVEL=info

# ------------------------------------------------------------------------------
# CloudQuery Hub Authentication
# ------------------------------------------------------------------------------
# Required when using plugins hosted on the CloudQuery Hub (registry: cloudquery),
# such as the official cloudquery/aws plugin (v34+).
#
# Steps to obtain your API key:
# 1. Sign up / Log in at https://cloud.cloudquery.io
# 2. Go to Team Settings -> API Keys
# 3. Click 'Generate new key' and copy the token
# 4. Paste the key below:
CLOUDQUERY_API_KEY=your_api_key_here

# ------------------------------------------------------------------------------
# AWS Authentication (Optional override)
# ------------------------------------------------------------------------------
# If running on an EC2 instance with an IAM Role attached (recommended), these
# are NOT required. The AWS SDK will automatically detect the Instance Profile.
# If running outside AWS or using static service credentials, uncomment below:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1

